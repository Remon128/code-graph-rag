FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir streamlit requests pillow

COPY codebase_rag/web_ui.py ./web_ui.py
COPY codebase_rag/assets ./assets

EXPOSE 8501

CMD ["streamlit", "run", "web_ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]