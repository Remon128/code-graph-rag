# Backend Dockerfile for code-graph-rag
FROM python:3.12-slim-bookworm

# Install system dependencies (ONE block only)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    build-essential \
    git \
    curl \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_SYSTEM_PYTHON=1

# Install uv package manager
RUN pip install uv

# Working directory
WORKDIR /app

# Copy dependency files FIRST
COPY pyproject.toml uv.lock* ./

# Copy project BEFORE uv sync (so codebase_rag exists)
COPY . .

# Install dependencies via uv (now project directory exists)
RUN uv sync --extra treesitter-full --extra semantic --no-dev \
    || uv sync --extra semantic --no-dev \
    || uv sync --no-dev

# Ensure mount path exists
RUN mkdir -p /repo

# Entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "=== Code Graph RAG Backend ==="\n\
echo "Waiting for Memgraph to be ready..."\n\
\n\
MAX_RETRIES=30\n\
RETRY_COUNT=0\n\
while ! python - <<EOF 2>/dev/null\n\
from codebase_rag.services.graph_service import MemgraphIngestor\n\
MemgraphIngestor(host="${MEMGRAPH_HOST:-memgraph}", port=int("${MEMGRAPH_PORT:-7687}"))\n\
EOF\n\
do\n\
    RETRY_COUNT=$((RETRY_COUNT + 1))\n\
    if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then\n\
        echo "ERROR: Could not connect to Memgraph after $MAX_RETRIES attempts"\n\
        exit 1\n\
    fi\n\
    echo "Waiting for Memgraph... (attempt $RETRY_COUNT/$MAX_RETRIES)"\n\
    sleep 2\n\
done\n\
echo "Memgraph is ready!"\n\
\n\
if [ "$RUN_INDEXING" = "true" ] && [ -n "$TARGET_REPO_PATH" ]; then\n\
    echo "Running graph indexing for: $TARGET_REPO_PATH"\n\
    if [ "$CLEAN_DATABASE" = "true" ]; then\n\
        python -m codebase_rag.main start --repo-path "$TARGET_REPO_PATH" --update-graph --clean\n\
    else\n\
        python -m codebase_rag.main start --repo-path "$TARGET_REPO_PATH" --update-graph\n\
    fi\n\
    echo "Indexing complete!"\n\
fi\n\
\n\
echo "Starting FastAPI server on port 8000..."\n\
exec uvicorn codebase_rag.api_server:app --host 0.0.0.0 --port 8000\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Expose backend API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
